---
const tracks = [
	{ title: 'Tell Me Why', year: '2026', code: 'TMW.EXE', href: 'https://etmae.fanlink.tv/tellmewhy', featured: true },
	{ title: 'Silence', year: '2025', code: 'SILENCE.SYS', href: 'https://etmae.fanlink.tv/silence' },
	{ title: 'Remember', year: '2024', code: 'REM.TMP', href: 'https://etmae.fanlink.tv/remember' },
	{ title: 'Give Me a Little Love', year: '2024', code: 'GMLL.WAV', href: 'https://etmae.fanlink.tv/givemelove' },
	{ title: 'Lost', year: '2024', code: 'LOST.LOG', href: 'https://fanlink.tv/lostetmae' },
	{ title: 'Fall In Love', year: '2023', code: 'FIL.DAT', href: 'https://fanlink.tv/etmaeFallInLove' },
	{ title: 'El Reino De Los Recuerdos Olvidados', year: '2022', code: 'ERRO.ZIP', href: 'https://fanlink.tv/ERDLROEP' },
];

const fanlink = 'https://etmae.fanlink.tv/tellmewhy';
const spotifyLink = 'https://open.spotify.com/album/0pTFgF72Nx0OhKdXJ7jYFJ';
const deezerLink = 'https://www.deezer.com/us/album/937244001';
const socialLinks = [
	{ label: 'TikTok', href: 'https://www.tiktok.com/@etmaemusic', icon: 'video' },
	{ label: 'Tumblr', href: 'https://www.tumblr.com/etmaemusic', icon: 'link' },
	{ label: 'Snapchat', href: 'https://www.snapchat.com/add/etmaemusic?share_id=rbcUyvKnMCM&locale=es-MX', icon: 'camera' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#09070d" />
		<meta name="description" content="Etmae transforma recuerdos, soledad y señales perdidas en música electrónica." />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=VT323&display=swap" rel="stylesheet" />
		<title>Etmae — De la soledad nació el sonido</title>
	</head>
	<body>
		<svg class="svg-library" aria-hidden="true">
			<defs>
				<symbol id="i-play" viewBox="0 0 24 24"><path d="m7 4 13 8L7 20V4Z" /></symbol>
				<symbol id="i-folder" viewBox="0 0 24 24"><path d="M3 6h7l2 2h9v11H3V6Z" /><path d="M3 9h18" /></symbol>
				<symbol id="i-music" viewBox="0 0 24 24"><path d="M9 18V5l11-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="17" cy="16" r="3" /></symbol>
				<symbol id="i-external" viewBox="0 0 24 24"><path d="M14 5h5v5M19 5l-9 9" /><path d="M19 14v5H5V5h5" /></symbol>
				<symbol id="i-video" viewBox="0 0 24 24"><rect x="3" y="5" width="14" height="14" rx="1" /><path d="m17 10 4-2v8l-4-2" /></symbol>
				<symbol id="i-link" viewBox="0 0 24 24"><path d="m10 14 4-4" /><path d="M7 17H5a4 4 0 0 1 0-8h3M17 7h2a4 4 0 0 1 0 8h-3" /></symbol>
				<symbol id="i-camera" viewBox="0 0 24 24"><path d="M4 7h4l2-2h4l2 2h4v12H4V7Z" /><circle cx="12" cy="13" r="4" /></symbol>
				<symbol id="i-sound" viewBox="0 0 24 24"><path d="M4 10v4h4l5 4V6l-5 4H4Z" /><path d="M16 9a4 4 0 0 1 0 6M18 6a8 8 0 0 1 0 12" /></symbol>
				<symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M14 7l5 5-5 5" /></symbol>
			</defs>
		</svg>

		<div class="noise" aria-hidden="true"></div>
		<div class="scanlines" aria-hidden="true"></div>
		<div class="scroll-progress" aria-hidden="true"><i></i></div>

		<header class="site-header">
			<a class="wordmark" href="#inicio" aria-label="Etmae, inicio">
				<img src="/logo-etmae-lp.png" alt="Etmae" width="1024" height="1024" />
			</a>
			<nav aria-label="Navegación principal">
				<a href="#archivo">ARCHIVO</a>
				<a href="#musica">MÚSICA</a>
				<a href="#conectar">CONECTAR</a>
			</nav>
			<span class="system-time" id="system-time" aria-label="Hora local">--:--</span>
		</header>

		<main>
			<section class="hero" id="inicio">
				<div class="hero-orbit" aria-hidden="true">
					<span class="orbit orbit-one"></span>
					<span class="orbit orbit-two"></span>
					<span class="signal-dot"></span>
				</div>
				<div class="vhs-status" aria-hidden="true">
					<span>PLAY ▶</span>
					<span>SP</span>
					<span>00:00:01</span>
				</div>
				<div class="hero-copy">
					<p class="eyebrow"><span></span> TRANSMISIÓN ACTIVA / 2026</p>
					<div class="window logo-window">
						<div class="titlebar logo-titlebar">
							<span><svg><use href="#i-folder"></use></svg> ETMAE_BRAND.BMP</span>
							<div class="window-controls" aria-hidden="true"><i>_</i><i>×</i></div>
						</div>
						<h1 class="hero-logo">
							<img src="/logo-etmae-lp.png" alt="Etmae" width="1024" height="1024" />
						</h1>
					</div>
					<p class="manifesto">De la soledad<br />nació el <em>sonido.</em></p>
					<p class="intro">Recuerdos convertidos en archivos. Emociones que siguen ejecutándose. Música electrónica para quienes habitan entre la nostalgia y el ruido.</p>
					<div class="hero-actions">
						<a class="win-button primary" href={fanlink} target="_blank" rel="noreferrer">
							<svg><use href="#i-play"></use></svg>
							ESCUCHAR TELL ME WHY
						</a>
						<a class="text-link" href="#archivo">ABRIR ARCHIVO <svg><use href="#i-arrow"></use></svg></a>
					</div>
				</div>
				<div class="hero-visual" aria-label="Visual temporal para portada de Etmae">
					<div class="window media-window">
						<div class="titlebar">
							<span><svg><use href="#i-folder"></use></svg> NOW_PLAYING.EXE</span>
							<div class="window-controls" aria-hidden="true"><i>_</i><i>□</i><i>×</i></div>
						</div>
						<div class="visual-placeholder">
							<img src="/tell-me-why-artwork.png" alt="Arte visual de Tell Me Why: una figura ante una luna digital" width="1024" height="1024" />
							<span class="image-status" aria-hidden="true">TELL_ME_WHY.PNG / 1024 × 1024</span>
						</div>
						<div class="player-strip">
							<a class="player-play" href={fanlink} target="_blank" rel="noreferrer" aria-label="Abrir Tell Me Why"><svg><use href="#i-play"></use></svg></a>
							<div>
								<strong>TELL ME WHY</strong>
								<span>ETMAE / 2026</span>
							</div>
							<div class="stream-services">
								<a href={spotifyLink} target="_blank" rel="noreferrer">SPOTIFY</a>
								<a href={deezerLink} target="_blank" rel="noreferrer">DEEZER</a>
							</div>
						</div>
					</div>
					<span class="coordinate">X:091.4<br />Y:095.0</span>
				</div>
			</section>

			<section class="archive-section" id="archivo">
				<div class="section-index">01</div>
				<div class="archive-layout">
					<div class="window archive-window">
						<div class="titlebar purple">
							<span><svg><use href="#i-folder"></use></svg> C:\ETMAE\ARCHIVO\README.TXT</span>
							<div class="window-controls" aria-hidden="true"><i>_</i><i>□</i><i>×</i></div>
						</div>
						<div class="archive-toolbar"><span>Archivo</span><span>Editar</span><span>Buscar</span><span>Ayuda</span></div>
						<div class="archive-content">
							<p class="prompt">C:\ETMAE&gt; OPEN README.TXT<span class="cursor">_</span></p>
							<h2>UN SISTEMA PARA<br />PROCESAR LO QUE SIENTO.</h2>
							<div class="archive-columns">
								<p>No hago música para explicar lo que pasó. La hago para conservar cómo se sintió.</p>
								<p>Pienso en emociones como sistemas: errores, archivos corruptos y procesos que siguen activos aunque nadie los necesite.</p>
							</div>
							<p class="system-message">[ OK ] Si tú también lo sentiste, la conexión fue establecida.</p>
						</div>
					</div>
					<div class="artist-visuals" aria-label="Retratos visuales de Etmae">
						<figure class="window portrait-window">
							<div class="titlebar"><span>ETMAE_PROFILE.JPG</span><div class="window-controls" aria-hidden="true"><i>×</i></div></div>
							<img src="/etmae-profile.png" alt="Retrato ilustrado de Etmae" width="1024" height="1024" loading="lazy" />
							<figcaption>ARTISTA / PRODUCTOR</figcaption>
						</figure>
						<figure class="window dj-window">
							<div class="titlebar"><span>LIVE_SESSION.JPG</span><div class="window-controls" aria-hidden="true"><i>×</i></div></div>
							<img src="/etmae-dj.png" alt="Etmae tocando en una cabina futurista" width="1024" height="1024" loading="lazy" />
							<figcaption>SEÑAL EN VIVO</figcaption>
						</figure>
					</div>
				</div>
			</section>

			<section class="music-section" id="musica">
				<div class="section-heading">
					<div>
						<p class="eyebrow"><span></span> DIRECTORIO PÚBLICO</p>
						<h2>ARCHIVOS DE AUDIO</h2>
					</div>
					<p>Selecciona un archivo para abrir la transmisión.</p>
				</div>
				<div class="track-browser">
					<div class="browser-header" aria-hidden="true">
						<span>NOMBRE</span><span>TIPO</span><span>FECHA</span><span>ACCIÓN</span>
					</div>
					{tracks.map((track) => (
						<a class:list={['track-row', { featured: track.featured }]} href={track.href} target="_blank" rel="noreferrer">
							<span class="track-name">
								<svg><use href="#i-music"></use></svg>
								<span><strong>{track.title}</strong><small>{track.code}</small></span>
							</span>
							<span>AUDIO</span>
							<span>{track.year}</span>
							<span class="row-action">{track.featured ? 'ESCUCHAR' : 'ABRIR'} <svg><use href="#i-external"></use></svg></span>
						</a>
					))}
				</div>
				<p class="track-note">* Cada archivo abre el smart link oficial de su lanzamiento.</p>
			</section>

			<section class="connect-section" id="conectar">
				<div class="connect-copy">
					<p class="eyebrow"><span></span> CANALES ABIERTOS</p>
					<h2>ENCUÉNTRAME<br />EN LA RED.</h2>
					<p>La señal continúa fuera de esta ventana.</p>
				</div>
				<div class="social-grid">
					<a class="social-card main-link" href={fanlink} target="_blank" rel="noreferrer">
						<svg><use href="#i-sound"></use></svg>
						<div><small>ESCUCHA AHORA</small><strong>Tell Me Why</strong></div>
						<svg class="external"><use href="#i-external"></use></svg>
					</a>
					{socialLinks.map((social) => (
						<a class="social-card" href={social.href} target="_blank" rel="noreferrer">
							<svg><use href={`#i-${social.icon}`}></use></svg>
							<div><small>SÍGUEME EN</small><strong>{social.label}</strong></div>
							<svg class="external"><use href="#i-external"></use></svg>
						</a>
					))}
				</div>
			</section>
		</main>

		<footer>
			<div class="status-light"><i></i> SISTEMA EN LÍNEA</div>
			<p>© 2026 ETMAE / TODOS LOS DERECHOS RESERVADOS</p>
			<a href="#inicio">VOLVER ARRIBA <span aria-hidden="true">↑</span></a>
		</footer>

		<script>
			import Lenis from 'lenis';
			import 'lenis/dist/lenis.css';

			const timeElement = document.querySelector('#system-time');
			const updateTime = () => {
				if (timeElement) timeElement.textContent = new Date().toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
			};
			updateTime();
			setInterval(updateTime, 30000);

			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const revealElements = document.querySelectorAll(
				'.hero-copy, .media-window, .archive-window, .artist-visuals, .section-heading, .track-row, .connect-copy, .social-card'
			);

			if (!reducedMotion) {
				document.documentElement.classList.add('motion-ready');
				revealElements.forEach((element, index) => {
					element.classList.add('reveal-item');
					if (element.classList.contains('track-row') || element.classList.contains('social-card')) {
						(element as HTMLElement).style.setProperty('--reveal-delay', `${(index % 7) * 45}ms`);
					}
				});

				const observer = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					});
				}, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });

				revealElements.forEach((element) => observer.observe(element));

				const lenis = new Lenis({
					duration: 1.15,
					easing: (value) => Math.min(1, 1.001 - Math.pow(2, -10 * value)),
					smoothWheel: true,
					wheelMultiplier: 0.9,
					touchMultiplier: 1.05,
					anchors: { offset: -72 },
				});

				lenis.on('scroll', ({ scroll, progress }: { scroll: number; progress: number }) => {
					document.documentElement.style.setProperty('--page-progress', `${progress}`);
					document.documentElement.style.setProperty('--parallax-y', `${Math.min(scroll * 0.08, 90)}px`);
				});

				const frame = (time: number) => {
					lenis.raf(time);
					requestAnimationFrame(frame);
				};
				requestAnimationFrame(frame);
			} else {
				document.documentElement.style.setProperty('--page-progress', '0');
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		--black: #070609;
		--ink: #0e0b13;
		--panel: #17121e;
		--panel-2: #21192b;
		--line: #493a58;
		--muted: #9c90aa;
		--white: #eeeaf3;
		--purple: #7450a6;
		--violet: #a574ea;
		--lavender: #c9a8fa;
		--green: #78e6af;
		--mono: 'IBM Plex Mono', monospace;
		--display: 'VT323', monospace;
		--page-progress: 0;
		--parallax-y: 0px;
	}
	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; background: var(--black); }
	body { margin: 0; background: var(--black); color: var(--white); font-family: var(--mono); overflow-x: hidden; }
	body::before {
		content: ''; position: fixed; inset: 0; pointer-events: none; z-index: 20;
		background: radial-gradient(circle at 73% 20%, rgba(116,80,166,.16), transparent 35%), radial-gradient(circle at 18% 65%, rgba(76,45,111,.1), transparent 30%);
	}
	a { color: inherit; text-decoration: none; }
	button { font: inherit; }
	svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: square; stroke-linejoin: miter; }
	.svg-library { position: absolute; width: 0; height: 0; overflow: hidden; }
	.noise { position: fixed; inset: 0; z-index: 21; pointer-events: none; opacity: .035; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.8'/%3E%3C/svg%3E"); }
	.scanlines { position: fixed; inset: 0; z-index: 19; pointer-events: none; opacity: .045; background: repeating-linear-gradient(0deg, transparent 0 3px, #fff 4px); }
	.scroll-progress { position:fixed; z-index:50; top:0; left:0; width:100%; height:2px; pointer-events:none; background:rgba(165,116,234,.08); }
	.scroll-progress i { display:block; width:100%; height:100%; transform:scaleX(var(--page-progress)); transform-origin:left center; background:linear-gradient(90deg,var(--purple),var(--lavender)); box-shadow:0 0 12px var(--violet); }
	.site-header {
		height: 72px; max-width: 1440px; margin: auto; padding: 0 clamp(20px, 5vw, 72px); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
		border-bottom: 1px solid #211a28; position: sticky; top:0; z-index: 30; background: #010103;
	}
	.wordmark { width:140px; height:42px; display:block; overflow:hidden; position:relative; background:#010103; }
	.wordmark img { position:absolute; top:0; left:0; width:100%; height:auto; display:block; transform:translateY(-30%); filter:contrast(1.08) brightness(1.12); }
	nav { display: flex; gap: clamp(20px, 4vw, 56px); font-size: 11px; letter-spacing: 1.5px; color: var(--muted); }
	nav a { transition: color .2s; } nav a:hover { color: var(--lavender); }
	.system-time { justify-self: end; border: 2px inset #2c2434; padding: 6px 10px; color: var(--muted); font-size: 11px; }
	main { max-width: 1440px; margin: auto; border-inline: 1px solid #17121d; position: relative; z-index: 2; }
	.hero { min-height: 750px; display: grid; grid-template-columns: 1.02fr .98fr; position: relative; padding: clamp(70px, 9vw, 130px) clamp(24px, 7vw, 100px); overflow: hidden; border-bottom: 1px solid #241b2c; }
	.hero::before { content:''; position:absolute; inset:0; background-image: linear-gradient(#17121d 1px, transparent 1px), linear-gradient(90deg,#17121d 1px,transparent 1px); background-size: 64px 64px; mask-image: linear-gradient(to bottom,black,transparent 80%); opacity:.35; }
	.hero-copy { position: relative; z-index: 2; align-self: center; }
	.eyebrow { color: var(--lavender); font-size: 11px; letter-spacing: 2px; display: flex; align-items: center; gap: 10px; margin: 0 0 20px; }
	.eyebrow span { width: 8px; height: 8px; background: var(--violet); box-shadow: 0 0 10px var(--violet); }
	.window.logo-window { width:min(100%,590px); margin:22px 0 38px; box-shadow:8px 8px 0 rgba(0,0,0,.5); }
	.titlebar.logo-titlebar { height:29px; }
	.titlebar.logo-titlebar .window-controls i { width:21px; height:20px; }
	.hero-logo { width:calc(100% - 6px); height:clamp(120px,13vw,175px); margin:3px; overflow:hidden; position:relative; background:#000; border:2px inset #24282a; }
	.hero-logo img { position:absolute; top:0; left:0; width:100%; height:auto; display:block; transform:translateY(-30%); filter:contrast(1.08) brightness(1.15); }
	.manifesto { font-size: clamp(22px, 2.4vw, 34px); line-height: 1.25; letter-spacing: -1px; margin: 0 0 24px; }
	.manifesto em { color: var(--lavender); font-style: normal; }
	.intro { max-width: 590px; color: var(--muted); line-height: 1.8; font-size: 13px; }
	.hero-actions { display: flex; align-items: center; gap: 28px; margin-top: 36px; flex-wrap: wrap; }
	.win-button { min-height: 48px; display: inline-flex; align-items: center; gap: 12px; padding: 0 20px; font-size: 11px; font-weight: 600; letter-spacing: .7px; border: 2px outset #c8a7ee; box-shadow: 4px 4px 0 #08060b; transition: transform .15s; }
	.win-button.primary { background: var(--purple); }
	.win-button:hover { transform: translate(-2px,-2px); box-shadow: 6px 6px 0 #08060b; background: #8760b9; }
	.win-button:active { border-style: inset; transform: translate(2px,2px); box-shadow: 1px 1px 0 #08060b; }
	.win-button svg { fill: currentColor; stroke: none; width: 15px; }
	.text-link { font-size: 10px; color: var(--muted); display: inline-flex; align-items: center; gap: 8px; border-bottom: 1px solid var(--line); padding-bottom: 5px; }
	.text-link:hover { color: var(--lavender); }
	.text-link svg { width: 14px; height: 14px; }
	.hero-visual { position: relative; align-self: center; z-index: 2; padding-left: clamp(20px,5vw,70px); }
	.window { background: #424749; color: #f0ecf3; border: 3px outset #656c6f; box-shadow: 14px 14px 0 rgba(0,0,0,.42); }
	.titlebar { height: 34px; padding: 3px 4px 3px 8px; display: flex; align-items: center; justify-content: space-between; background: linear-gradient(90deg,#352149,#7750a3); color: #fff; font-size: 10px; letter-spacing: .5px; font-weight: 600; }
	.titlebar > span { display: flex; align-items: center; gap: 7px; overflow: hidden; white-space: nowrap; }
	.titlebar svg { width: 15px; height: 15px; fill: #d8c3f1; }
	.window-controls { display: flex; gap: 3px; }
	.window-controls i { font-style: normal; width: 23px; height: 23px; display: grid; place-items: center; background: #424749; color: #f0ecf3; border: 2px outset #697174; line-height: 1; font-size: 13px; }
	.visual-placeholder { aspect-ratio: 1/1; background: #000; margin: 5px; color: #79658a; position: relative; overflow: hidden; border: 2px inset #24282a; }
	.visual-placeholder::before { content:''; position:absolute; inset:0; z-index:2; pointer-events:none; background: repeating-linear-gradient(0deg,transparent 0 3px,rgba(163,118,214,.07) 4px), radial-gradient(circle,transparent 55%,rgba(48,20,69,.2)); }
	.visual-placeholder img { width:100%; height:100%; display:block; object-fit:cover; filter:contrast(1.08) saturate(.9); }
	.image-status { position:absolute; left:13px; bottom:11px; z-index:3; padding:5px 7px; color:#aa90be; background:rgba(0,0,0,.72); border-left:2px solid var(--violet); font-size:7px; letter-spacing:1px; }
	.player-strip { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; padding: 7px; }
	.player-play { width: 38px; height: 38px; display:grid; place-items:center; border:2px outset #697174; background:#424749; color:#f0ecf3; }
	.player-play:active { border-style:inset; }
	.player-play svg { width:14px; fill:currentColor; stroke:none; }
	.player-strip div:nth-child(2) { display:flex; flex-direction:column; gap:3px; }
	.player-strip strong { font-size:10px; } .player-strip span { font-size:8px; color:#bac0c2; }
