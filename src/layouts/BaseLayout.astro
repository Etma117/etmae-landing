---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Etmae — De la soledad nació el sonido',
	description = 'Etmae transforma recuerdos, soledad y señales perdidas en música electrónica.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#09070d" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=VT323&display=swap" rel="stylesheet" />
		<title>{title}</title>
	</head>
	<body>
		<svg class="svg-library" aria-hidden="true">
			<defs>
				<symbol id="i-play" viewBox="0 0 24 24"><path d="m7 4 13 8L7 20V4Z" /></symbol>
				<symbol id="i-folder" viewBox="0 0 24 24"><path d="M3 6h7l2 2h9v11H3V6Z" /><path d="M3 9h18" /></symbol>
				<symbol id="i-music" viewBox="0 0 24 24"><path d="M9 18V5l11-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="17" cy="16" r="3" /></symbol>
				<symbol id="i-external" viewBox="0 0 24 24"><path d="M14 5h5v5M19 5l-9 9" /><path d="M19 14v5H5V5h5" /></symbol>
				<symbol id="i-video" viewBox="0 0 24 24"><rect x="3" y="5" width="14" height="14" rx="1" /><path d="m17 10 4-2v8l-4-2" /></symbol>
				<symbol id="i-link" viewBox="0 0 24 24"><path d="m10 14 4-4" /><path d="M7 17H5a4 4 0 0 1 0-8h3M17 7h2a4 4 0 0 1 0 8h-3" /></symbol>
				<symbol id="i-camera" viewBox="0 0 24 24"><path d="M4 7h4l2-2h4l2 2h4v12H4V7Z" /><circle cx="12" cy="13" r="4" /></symbol>
				<symbol id="i-sound" viewBox="0 0 24 24"><path d="M4 10v4h4l5 4V6l-5 4H4Z" /><path d="M16 9a4 4 0 0 1 0 6M18 6a8 8 0 0 1 0 12" /></symbol>
				<symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M14 7l5 5-5 5" /></symbol>
				<symbol id="i-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="1" /><path d="m3 7 9 7 9-7" /></symbol>
				<symbol id="i-youtube" viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="3" /><path d="m10 9 6 3-6 3V9Z" /></symbol>
				<symbol id="i-instagram" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".6" /></symbol>
				<symbol id="i-facebook" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3V2Z" /></symbol>
				<symbol id="i-spotify" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M7.8 10.2c3.2-1.4 6.8-1.5 10.4-.2M8 13.2c2.6-1.1 5.6-1.2 8.6-.2M8.4 16c2-.8 4.2-.9 6.4-.2" /></symbol>
				<symbol id="i-doc" viewBox="0 0 24 24"><path d="M7 3h8l5 5v13H7V3Z" /><path d="M15 3v5h5M9 13h6M9 17h6" /></symbol>
				<symbol id="i-back" viewBox="0 0 24 24"><path d="M19 12H5M10 17l-5-5 5-5" /></symbol>
			</defs>
		</svg>

		<div class="noise" aria-hidden="true"></div>
		<div class="scanlines" aria-hidden="true"></div>
		<div class="scroll-progress" aria-hidden="true"><i></i></div>

		<header class="site-header">
			<a class="wordmark" href="/#inicio" aria-label="Etmae, inicio">
				<img src="/logo-etmae-lp.png" alt="Etmae" width="1024" height="1024" />
			</a>
			<nav aria-label="Navegación principal">
				<a href="/#archivo">ARCHIVO</a>
				<a href="/#musica">MÚSICA</a>
				<a href="/#conectar">CONECTAR</a>
			</nav>
			<span class="system-time" id="system-time" aria-label="Hora local">--:--</span>
		</header>

		<slot />

		<footer>
			<div class="status-light"><i></i> SISTEMA EN LÍNEA</div>
			<p>© 2026 ETMAE / TODOS LOS DERECHOS RESERVADOS</p>
			<a href="/#inicio">VOLVER ARRIBA <span aria-hidden="true">↑</span></a>
		</footer>

		<script>
			import Lenis from 'lenis';
			import 'lenis/dist/lenis.css';

			const timeElement = document.querySelector('#system-time');
			const updateTime = () => {
				if (timeElement) timeElement.textContent = new Date().toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
			};
			updateTime();
			setInterval(updateTime, 30000);

			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const revealElements = document.querySelectorAll(
				'.hero-copy, .media-window, .archive-window, .artist-visuals, .section-heading, .track-row, .history-row, .connect-copy, .social-card, .story-window, .story-side'
			);

			if (!reducedMotion) {
				document.documentElement.classList.add('motion-ready');
				revealElements.forEach((element, index) => {
					element.classList.add('reveal-item');
					if (element.classList.contains('track-row') || element.classList.contains('history-row') || element.classList.contains('social-card')) {
						(element as HTMLElement).style.setProperty('--reveal-delay', `${(index % 8) * 45}ms`);
					}
				});

				const observer = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					});
				}, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });

				revealElements.forEach((element) => observer.observe(element));

				const lenis = new Lenis({
					duration: 1.15,
					easing: (value) => Math.min(1, 1.001 - Math.pow(2, -10 * value)),
					smoothWheel: true,
					wheelMultiplier: 0.9,
					touchMultiplier: 1.05,
					anchors: { offset: -72 },
				});

				lenis.on('scroll', ({ scroll, progress }: { scroll: number; progress: number }) => {
					document.documentElement.style.setProperty('--page-progress', `${progress}`);
					document.documentElement.style.setProperty('--parallax-y', `${Math.min(scroll * 0.08, 90)}px`);
				});

				const frame = (time: number) => {
					lenis.raf(time);
					requestAnimationFrame(frame);
				};
				requestAnimationFrame(frame);
			} else {
				document.documentElement.style.setProperty('--page-progress', '0');
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		--black: #070609;
		--ink: #0e0b13;
		--panel: #17121e;
		--panel-2: #21192b;
		--line: #493a58;
		--muted: #9c90aa;
		--white: #eeeaf3;
		--purple: #7450a6;
		--violet: #a574ea;
		--lavender: #c9a8fa;
		--green: #78e6af;
		--mono: 'IBM Plex Mono', monospace;
		--display: 'VT323', monospace;
		--page-progress: 0;
		--parallax-y: 0px;
	}
	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; background: var(--black); }
	body { margin: 0; background: var(--black); color: var(--white); font-family: var(--mono); overflow-x: hidden; }
	body::before {
		content: ''; position: fixed; inset: 0; pointer-events: none; z-index: 20;
		background: radial-gradient(circle at 73% 20%, rgba(116,80,166,.16), transparent 35%), radial-gradient(circle at 18% 65%, rgba(76,45,111,.1), transparent 30%);
	}
	a { color: inherit; text-decoration: none; }
	button { font: inherit; }
	svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: square; stroke-linejoin: miter; }
	.svg-library { position: absolute; width: 0; height: 0; overflow: hidden; }
	.noise { position: fixed; inset: 0; z-index: 21; pointer-events: none; opacity: .035; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.8'/%3E%3C/svg%3E"); }
	.scanlines { position: fixed; inset: 0; z-index: 19; pointer-events: none; opacity: .045; background: repeating-linear-gradient(0deg, transparent 0 3px, #fff 4px); }
	.scroll-progress { position:fixed; z-index:50; top:0; left:0; width:100%; height:2px; pointer-events:none; background:rgba(165,116,234,.08); }
	.scroll-progress i { display:block; width:100%; height:100%; transform:scaleX(var(--page-progress)); transform-origin:left center; background:linear-gradient(90deg,var(--purple),var(--lavender)); box-shadow:0 0 12px var(--violet); }
	.site-header {
		height: 72px; max-width: 1440px; margin: auto; padding: 0 clamp(20px, 5vw, 72px); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
		border-bottom: 1px solid #211a28; position: sticky; top:0; z-index: 30; background: #010103;
	}
	.wordmark { width:140px; height:42px; display:block; overflow:hidden; position:relative; background:#010103; }
	.wordmark img { position:absolute; top:0; left:0; width:100%; height:auto; display:block; transform:translateY(-30%); filter:contrast(1.08) brightness(1.12); }
	nav { display: flex; gap: clamp(16px, 3.2vw, 48px); font-size: 11px; letter-spacing: 1.5px; color: var(--muted); }
	nav a { transition: color .2s; } nav a:hover { color: var(--lavender); }
	.system-time { justify-self: end; border: 2px inset #2c2434; padding: 6px 10px; color: var(--muted); font-size: 11px; }
	main { max-width: 1440px; margin: auto; border-inline: 1px solid #17121d; position: relative; z-index: 2; }
	.hero { min-height: 750px; display: grid; grid-template-columns: 1.02fr .98fr; position: relative; padding: clamp(70px, 9vw, 130px) clamp(24px, 7vw, 100px); overflow: hidden; border-bottom: 1px solid #241b2c; }
	.hero::before { content:''; position:absolute; inset:0; background-image: linear-gradient(#17121d 1px, transparent 1px), linear-gradient(90deg,#17121d 1px,transparent 1px); background-size: 64px 64px; mask-image: linear-gradient(to bottom,black,transparent 80%); opacity:.35; }
	.hero-copy { position: relative; z-index: 2; align-self: center; }
	.eyebrow { color: var(--lavender); font-size: 11px; letter-spacing: 2px; display: flex; align-items: center; gap: 10px; margin: 0 0 20px; }
	.eyebrow span { width: 8px; height: 8px; background: var(--violet); box-shadow: 0 0 10px var(--violet); }
	.window.logo-window { width:min(100%,590px); margin:22px 0 38px; box-shadow:8px 8px 0 rgba(0,0,0,.5); }
	.titlebar.logo-titlebar { height:29px; }
	.titlebar.logo-titlebar .window-controls i { width:21px; height:20px; }
	.hero-logo { width:calc(100% - 6px); height:clamp(120px,13vw,175px); margin:3px; overflow:hidden; position:relative; background:#000; border:2px inset #24282a; }
	.hero-logo img { position:absolute; top:0; left:0; width:100%; height:auto; display:block; transform:translateY(-30%); filter:contrast(1.08) brightness(1.15); }
	.manifesto { font-size: clamp(22px, 2.4vw, 34px); line-height: 1.25; letter-spacing: -1px; margin: 0 0 24px; }
	.manifesto em { color: var(--lavender); font-style: normal; }
	.intro { max-width: 590px; color: var(--muted); line-height: 1.8; font-size: 13px; }
	.hero-actions { display: flex; align-items: center; gap: 28px; margin-top: 36px; flex-wrap: wrap; }
	.win-button { min-height: 48px; display: inline-flex; align-items: center; gap: 12px; padding: 0 20px; font-size: 11px; font-weight: 600; letter-spacing: .7px; border: 2px outset #c8a7ee; box-shadow: 4px 4px 0 #08060b; transition: transform .15s; }
	.win-button.primary { background: var(--purple); }
	.win-button:hover { transform: translate(-2px,-2px); box-shadow: 6px 6px 0 #08060b; background: #8760b9; }
	.win-button:active { border-style: inset; transform: translate(2px,2px); box-shadow: 1px 1px 0 #08060b; }
	.win-button svg { fill: currentColor; stroke: none; width: 15px; }
	.text-link { font-size: 10px; color: var(--muted); display: inline-flex; align-items: center; gap: 8px; border-bottom: 1px solid var(--line); padding-bottom: 5px; }
	.text-link:hover { color: var(--lavender); }
	.text-link svg { width: 14px; height: 14px; }
	.hero-visual { position: relative; align-self: center; z-index: 2; padding-left: clamp(20px,5vw,70px); }
	.window { background: #424749; color: #f0ecf3; border: 3px outset #656c6f; box-shadow: 14px 14px 0 rgba(0,0,0,.42); }
	.titlebar { height: 34px; padding: 3px 4px 3px 8px; display: flex; align-items: center; justify-content: space-between; background: linear-gradient(90deg,#352149,#7750a3); color: #fff; font-size: 10px; letter-spacing: .5px; font-weight: 600; }
	.titlebar > span { display: flex; align-items: center; gap: 7px; overflow: hidden; white-space: nowrap; }
	.titlebar svg { width: 15px; height: 15px; fill: #d8c3f1; }
	.window-controls { display: flex; gap: 3px; }
	.window-controls i { font-style: normal; width: 23px; height: 23px; display: grid; place-items: center; background: #424749; color: #f0ecf3; border: 2px outset #697174; line-height: 1; font-size: 13px; }
	.visual-placeholder { aspect-ratio: 1/1; background: #000; margin: 5px; color: #79658a; position: relative; overflow: hidden; border: 2px inset #24282a; }
	.visual-placeholder::before { content:''; position:absolute; inset:0; z-index:2; pointer-events:none; background: repeating-linear-gradient(0deg,transparent 0 3px,rgba(163,118,214,.07) 4px), radial-gradient(circle,transparent 55%,rgba(48,20,69,.2)); }
	.visual-placeholder img { width:100%; height:100%; display:block; object-fit:cover; filter:contrast(1.08) saturate(.9); }
	.image-status { position:absolute; left:13px; bottom:11px; z-index:3; padding:5px 7px; color:#aa90be; background:rgba(0,0,0,.72); border-left:2px solid var(--violet); font-size:7px; letter-spacing:1px; }
	.player-strip { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; padding: 7px; }
	.player-play { width: 38px; height: 38px; display:grid; place-items:center; border:2px outset #697174; background:#424749; color:#f0ecf3; }
	.player-play:active { border-style:inset; }
	.player-play svg { width:14px; fill:currentColor; stroke:none; }
	.player-strip div:nth-child(2) { display:flex; flex-direction:column; gap:3px; }
	.player-strip strong { font-size:10px; } .player-strip span { font-size:8px; color:#bac0c2; }
	.stream-services { display:flex; flex-direction:row !important; gap:4px !important; }
	.stream-services a { padding:8px 7px; color:#f0ecf3; background:#424749; border:2px outset #697174; font-size:7px; font-weight:600; }
	.stream-services a:hover { background:#545b5e; color:var(--lavender); }
	.stream-services a:active { border-style:inset; }
	.coordinate { position:absolute; right:-22px; bottom:-40px; font-family:var(--display); font-size:17px; line-height:1.2; color:#594868; }
	.hero-orbit { position:absolute; width:660px; height:660px; right:-240px; top:-180px; border:1px solid #251a2d; border-radius:50%; transform:translate3d(0,var(--parallax-y),0); will-change:transform; }
	.orbit { position:absolute; border:1px solid #281d31; border-radius:50%; inset:80px; }
	.orbit-two { inset:180px; }
	.signal-dot { position:absolute; width:6px; height:6px; background:var(--violet); top:193px; left:18px; box-shadow:0 0 15px var(--violet); }
	.vhs-status { position:absolute; right:36px; top:32px; display:flex; gap:24px; font-family:var(--display); font-size:19px; color:#8a7895; opacity:.6; }
	.archive-section { padding: 130px clamp(24px,9vw,130px); position:relative; border-bottom:1px solid #241b2c; }
	.section-index { position:absolute; left:3vw; top:120px; color:#403448; font-family:var(--display); font-size:34px; }
	.archive-layout { display:grid; grid-template-columns:minmax(0,1.25fr) minmax(310px,.75fr); align-items:center; gap:clamp(35px,6vw,85px); max-width:1180px; margin:auto; }
	.archive-window { min-width:0; }
	.titlebar.purple { background:linear-gradient(90deg,#261437,#704897); }
	.archive-toolbar { height:32px; border-bottom:2px groove #656c6f; display:flex; align-items:center; gap:22px; padding:0 10px; font-size:9px; }
	.archive-content { background:#0e0b12; color:var(--white); margin:3px; padding:clamp(30px,4vw,62px); border:2px inset #24282a; min-height:500px; }
	.prompt { color:var(--green); font-size:11px; margin:0 0 52px; }
	.cursor { animation:blink 1s step-end infinite; } @keyframes blink { 50% { opacity:0; } }
	.archive-content h2,.section-heading h2,.connect-copy h2,.story-content h1,.history-index-copy h2 { font-family:var(--display); font-weight:400; font-size:clamp(44px,6vw,82px); line-height:.9; letter-spacing:1px; margin:0; }
	.archive-columns { display:grid; grid-template-columns:1fr 1fr; gap:30px; margin:54px 0; max-width:790px; color:#aaa0b1; font-size:12px; line-height:1.8; }
	.system-message { border-top:1px dashed #4c4053; padding-top:18px; color:var(--lavender); font-size:10px; }
	.artist-visuals { min-height:590px; position:relative; }
	.artist-visuals figure { margin:0; position:absolute; overflow:hidden; }
	.artist-visuals img { width:100%; height:auto; display:block; aspect-ratio:1; object-fit:cover; border:3px inset #24282a; filter:saturate(.78) contrast(1.08); }
	.artist-visuals figcaption { padding:9px 11px; color:#f0ecf3; background:#424749; font-size:8px; letter-spacing:1px; }
	.portrait-window { width:82%; left:0; top:0; z-index:1; transform:rotate(-1.5deg); }
	.dj-window { width:70%; right:0; bottom:0; z-index:2; transform:rotate(2deg); }
	.artist-visuals .window-controls i { width:22px; }
	.music-section { padding:130px clamp(24px,7vw,100px); border-bottom:1px solid #241b2c; }
	.section-anchor { display:block; height:0; scroll-margin-top:72px; }
	.section-heading { display:flex; justify-content:space-between; align-items:end; margin-bottom:54px; }
	.section-heading > p { color:var(--muted); font-size:11px; max-width:270px; line-height:1.6; }
	.track-browser { border:1px solid #44364f; background:#0c0a0f; scroll-margin-top:88px; }
	.browser-header,.track-row { display:grid; grid-template-columns:minmax(240px,2.4fr) .7fr 1fr 1fr; align-items:center; }
	.browser-header { min-height:34px; background:#211927; color:#7f718a; font-size:8px; letter-spacing:1.5px; border-bottom:1px solid #44364f; }
	.browser-header span,.track-row > * { padding-inline:18px; }
	.browser-header span+span,.track-row > * + * { border-left:1px solid #302638; }
	.track-row { min-height:76px; border-bottom:1px solid #211927; color:#8f8399; font-size:10px; transition:background .18s,color .18s; }
	.track-row.is-hidden { display:none; }
	.track-row:hover,.track-row.featured { background:#191220; color:var(--white); }
	.track-row.featured { box-shadow:inset 3px 0 var(--violet); }
	.track-name { display:flex; align-items:center; gap:14px; }
	.track-name > svg { color:var(--violet); width:20px; flex-shrink:0; }
	.track-name > span { display:flex; flex-direction:column; gap:4px; min-width:0; }
	.track-name strong { color:var(--white); font-size:12px; font-weight:500; }
	.track-name small { color:#665970; font-size:8px; }
	.row-action { display:flex; align-items:center; justify-content:space-between; color:var(--lavender); height:100%; min-height:76px; }
	.row-action:hover { color:var(--white); }
	.row-action svg { width:14px; flex-shrink:0; }
	.row-action.is-pending { color:#665970; letter-spacing:1px; }
	.win-button.is-pending { border-style:inset; background:#2a2233; color:#8f8399; box-shadow:none; cursor:default; }
	.track-pager {
		display:flex; align-items:center; gap:10px; flex-wrap:wrap;
		min-height:42px; padding:7px 10px; background:#211927; border-top:1px solid #44364f; color:#7f718a;
	}
	.pager-pages { display:flex; gap:4px; }
	.pager-btn {
		min-width:32px; height:26px; padding:0 8px; font:inherit; font-size:10px; letter-spacing:.6px;
		color:#f0ecf3; background:#424749; border:2px outset #697174; cursor:pointer;
	}
	.pager-btn:hover { color:var(--lavender); }
	.pager-btn:active,.pager-btn.is-active { border-style:inset; color:var(--lavender); }
	.pager-btn:disabled { opacity:.35; cursor:default; }
	.pager-status { margin:0 auto 0 8px; font-size:8px; letter-spacing:1.4px; }
	.track-note { color:#5f5269; font-size:8px; margin:14px 0 0; }
	.connect-section { padding:140px clamp(24px,9vw,130px); display:grid; grid-template-columns:.7fr 1.3fr; gap:clamp(60px,10vw,150px); align-items:center; min-height:610px; }
	.connect-copy > p:last-child { color:var(--muted); font-size:11px; margin-top:26px; }
	.social-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
	.social-card { min-height:112px; border:1px solid #3b3044; background:#120e17; display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:18px; padding:22px; transition:background .2s,transform .2s; }
	.social-card:hover { background:#21182b; transform:translateY(-3px); border-color:#71528d; }
	.social-card > svg:first-child { width:25px; height:25px; color:var(--lavender); }
